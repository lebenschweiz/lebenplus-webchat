# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Beispiel-Konfiguration soll ins Repo (die Regel .env* oben greift sonst)
!.env.local.example

# Laufzeitdaten: Sessions und Chatverlauf echter Besucher bleiben lokal.
# Die ManyChat-Dumps unter data/manychat/ sind dagegen Quelldaten und
# werden versioniert — ohne sie laesst sich der Konverter nicht erneut laufen.
data/chat.db
data/chat.db-journal
data/chat.db-wal
data/chat.db-shm
