# Alle Werte sind optional — ohne laeuft die App lokal komplett im Testmodus.

# --- Oeffentliche Adresse ----------------------------------------------------
# Fuer Login-Links in Mails, Google-Rueckleitung und Stripe. In Produktion
# Pflicht, ausser auf Railway (dort wird RAILWAY_PUBLIC_DOMAIN genutzt).
# APP_URL=http://localhost:3000

# --- Login per E-Mail-Link (Resend) ------------------------------------------
# Ohne Key wird der Login-Link nur ins Server-Log geschrieben.
# RESEND_API_KEY=re_...
# MAIL_FROM=Lebenplus <login@deine-domain.ch>

# --- Login mit Google ---------------------------------------------------------
# Ohne beide Werte wird der Google-Button ausgeblendet.
# Weiterleitungs-URI in der Google Cloud Console: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# --- Premium / Stripe ----------------------------------------------------------
# Ohne Stripe-Key laeuft die App im Simulationsmodus:
# jede E-Mail auf @test.* gilt als zahlender Kunde.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# Von Hand freigeschaltete Adressen (kommagetrennt), unabhaengig von Stripe.
# PREMIUM_EMAILS=team@lebenplus.ch

# Ablageort der SQLite-Datei (Standard: ./data/chat.db)
# CHAT_DB_PATH=./data/chat.db
